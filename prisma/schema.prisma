generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Trimmed to exactly what the face-only register/sign-in/welcome app uses.
// This used to be the full PinIt Hub schema (~140 models: DNA fingerprinting,
// Vault, Exchange, subscriptions, portfolios, forensics, crawler/monitoring,
// etc.) carried over from the original product. None of that application code
// exists in this repo anymore — see README.md — so the unused models were
// removed rather than left as ~110 permanently-empty tables.
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ANALYST
  AUDITOR
  USER
}

enum AccountType {
  INDIVIDUAL
  BUSINESS
}

enum WorkspaceShell {
  PERSONAL
  BUSINESS
}

model User {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shortId     String   @unique
  email       String?  @unique
  fullName    String   @default("PINIT User")
  role        UserRole @default(USER)
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  accountType     AccountType    @default(INDIVIDUAL)
  lastActiveShell WorkspaceShell @default(PERSONAL)

  // Face Recognition Auth — templates live in FaceTemplate (encrypted cipher only)
  faceRegistered       Boolean   @default(false)
  faceRegisteredAt     DateTime?
  voiceEmbedding       Float[]   @default([])
  voiceRegistered      Boolean   @default(false)
  webauthnCredentialId String?
  deviceFingerprint    String?
  authMethod           String    @default("biometric")

  webauthnCredentials WebAuthnCredential[]
  loginHistory        LoginHistory[]
  refreshTokens       RefreshToken[]

  // Enterprise biometric auth
  biometricIdentity BiometricIdentity?
  userSessions      UserSession[]
  userDevices       UserDevice[]
  securityEvents    SecurityEvent[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model UserSession {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  userId       String
  sessionHash  String    @unique
  deviceId     String?
  ip           String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastActiveAt DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserDevice {
  id                   String   @id @default(uuid())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  userId               String
  deviceFingerprint    String?
  webauthnCredentialId String?
  deviceLabel          String?
  lastSeenAt           DateTime @default(now())
  registeredAt         DateTime @default(now())
  isTrusted            Boolean  @default(true)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceFingerprint])
  @@index([userId])
  @@map("user_devices")
}

model WebAuthnCredential {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  credentialId String   @unique
  publicKey    String
  userId       String
  signCount    Int      @default(0)
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   String[] @default([])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

model SecurityEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String?
  eventType String
  ip        String?
  userAgent String?
  deviceId  String?
  success   Boolean  @default(true)
  detail    Json?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("security_events")
}

model LoginHistory {
  id                String   @id @default(uuid())
  createdAt         DateTime @default(now())
  userId            String
  method            String   @default("face")
  ip                String?
  userAgent         String?
  device            String?
  browser           String?
  os                String?
  city              String?
  country           String?
  success           Boolean  @default(true)
  failReason        String?
  ambientBrightness Int?
  lightingStatus    String?
  euclideanDistance Float?
  executionTimeMs   Float?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("login_history")
}

model BiometricIdentity {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String   @unique
  identityHash   String   @unique
  status         String   @default("ACTIVE")
  enrolledAt     DateTime @default(now())
  lastVerifiedAt DateTime?
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  faceTemplate        FaceTemplate?
  voiceTemplate       VoiceTemplate?
  fingerprintTemplate FingerprintTemplate?

  @@map("biometric_identities")
}

model FaceTemplate {
  id                   String            @id @default(uuid())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt
  biometricIdentityId  String            @unique
  templateCipher       String
  templateHash         String            @unique
  dimension            Int               @default(128)
  algorithm            String            @default("face-api-v1")
  // Versioning so a future face-model upgrade can migrate/re-enroll templates
  // deliberately instead of silently invalidating every existing one.
  embeddingVersion     String            @default("1")
  modelVersion         String            @default("face-api-tiny-v1")
  algorithmVersion     String            @default("1")
  /// PAD sharpness at enrollment. Null when no server-side signal was available.
  qualityScore         Float?
  status               String            @default("ACTIVE")
  encryptionKeyVersion String            @default("v1")
  biometricIdentity    BiometricIdentity @relation(fields: [biometricIdentityId], references: [id], onDelete: Cascade)

  @@index([templateHash])
  @@map("face_templates")
}

model VoiceTemplate {
  id                   String            @id @default(uuid())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt
  biometricIdentityId  String            @unique
  templateCipher       String
  templateHash         String            @unique
  dimension            Int               @default(128)
  algorithm            String            @default("web-audio-fft-v1")
  embeddingVersion     String            @default("1")
  modelVersion         String            @default("web-audio-fft-v1")
  algorithmVersion     String            @default("1")
  /// Always null today — voice quality is gated client-side and never sent to the server.
  qualityScore         Float?
  status               String            @default("ACTIVE")
  encryptionKeyVersion String            @default("v1")
  biometricIdentity    BiometricIdentity @relation(fields: [biometricIdentityId], references: [id], onDelete: Cascade)

  @@index([templateHash])
  @@map("voice_templates")
}

/// NOT a fingerprint biometric. This is a derived hash proxy over the WebAuthn
/// credential id / device fingerprint — PINIT never receives or stores fingerprint
/// images, minutiae, or any platform-authenticator biometric material.
model FingerprintTemplate {
  id                   String            @id @default(uuid())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt
  biometricIdentityId  String            @unique
  templateCipher       String
  templateHash         String            @unique
  dimension            Int               @default(128)
  algorithm            String            @default("webauthn-device-v1")
  credentialId         String?
  embeddingVersion     String            @default("1")
  modelVersion         String            @default("webauthn-device-v1")
  algorithmVersion     String            @default("1")
  /// Always null — a derived device proxy has no captured-sample quality.
  qualityScore         Float?
  status               String            @default("ACTIVE")
  encryptionKeyVersion String            @default("v1")
  biometricIdentity    BiometricIdentity @relation(fields: [biometricIdentityId], references: [id], onDelete: Cascade)

  @@index([templateHash])
  @@map("fingerprint_templates")
}
